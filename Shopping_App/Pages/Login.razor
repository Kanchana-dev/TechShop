@page "/login"
@using Shopping_App.Services

@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject WeatherProxyService weatherService

<div style="display: flex; justify-content: space-between; align-items: center;" class="col-md-3 offset-md-3">
    <h5 style="font-weight: bold;">Historical Weather</h5>
    <button class="btn btn-primary btn-sm" @onclick="GetWeatherDetails">
        ⟳ Refresh Data
    </button>

</div>

@if (IsLoading)
{
    <div class="d-flex align-items-center justify-content-center p-2 gap-1">
        <div class="spinner-grow text-primary" role="status" style="width: 1rem; height: 0.75rem;"></div>
        <div class="spinner-grow text-primary" role="status" style="width: 1rem; height: 0.75rem; animation-delay: 0.2s;"></div>
        <div class="spinner-grow text-primary" role="status" style="width: 1rem; height: 0.75rem; animation-delay: 0.4s;"></div>
        <span class="ms-2 fw-semibold text-secondary">Loading data...</span>
    </div>
}
else if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger col-md-3 offset-md-3 mt-3" role="alert">
        <strong>Error:</strong> @ErrorMessage
    </div>
}
else if (SortedWeather == null || !SortedWeather.Any())
{
    <div class="alert alert-warning col-md-3 offset-md-3 mt-3" role="alert">
        Unable to fetch weather details. Please Refresh.
    </div>
}
else
{
    <div class="col-md-3 offset-md-3 mt-4 w-50">
        <table class="table table-striped table-hover table-bordered">
            <thead>
                <tr>
                    <th @onclick='() => Sort("ProvidedDate")' style="cursor: pointer; user-select: none;">
                        ProvidedDate <span class="text-muted">@GetSortIcon("ProvidedDate")</span>
                    </th>
                    <th @onclick='() => Sort("MaxTemp")' style="cursor: pointer; user-select: none;">
                        MaxTemp <span class="text-muted">@GetSortIcon("MaxTemp")</span>
                    </th>
                    <th @onclick='() => Sort("MinTemp")' style="cursor: pointer; user-select: none;">
                        MiniTemp <span class="text-muted">@GetSortIcon("MinTemp")</span>
                    </th>
                    <th @onclick='() => Sort("Precipitation")' style="cursor: pointer; user-select: none;">
                        Precipitation <span class="text-muted">@GetSortIcon("Precipitation")</span>
                    </th>
                    <th @onclick='() => Sort("Error")' style="cursor: pointer; user-select: none;">
                        Message <span class="text-muted">@GetSortIcon("Error")</span>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var weather in SortedWeather)
                {
                    bool hasError = !string.IsNullOrWhiteSpace(weather.ErrorMessage);
                    string rowClass = hasError ? "table-danger" : "";

                    <tr class="@rowClass">
                        <td>@weather.ProvidedDate</td>
                        <td>@weather.MaxTemp</td>
                        <td>@weather.MinTemp</td>
                        <td>@weather.Precipitation</td>
                        <td>
                            @if (hasError)
                            {
                                <span class="text-danger fw-bold">@weather.ErrorMessage</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="col-md-3 offset-md-3 mt-5">
    <EditForm Model="@model" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />

		
        <div class="form-group">
            <label>Username</label>
            <InputText id="username" name="username" @bind-Value="model.UserName" class="form-control" required />
            <ValidationMessage For="@(() => model.UserName)" />
        </div>
        <div style="margin-bottom: 5px;">
            <span style="height:2px;">&nbsp;</span>
        </div>
        <div class="form-group">
            <label>Password</label>
            <InputText id="password" name="password" @bind-Value="model.Password" type="password" class="form-control" required />
            <ValidationMessage For="@(() => model.Password)" />
        </div>
        <div style="margin-bottom: 5px;">
            <span style="height:2px;">&nbsp;</span>
        </div>
        <div>
            <button class="btn btn-primary" type="submit">Login</button>
        </div>
        <div style="margin-bottom: 5px;">
            <span style="height:2px;">&nbsp;</span>
        </div>
        @if (error is not null)
        {
            <p class="error" style="color:red">@error</p>
        }
    </EditForm>
</div>


